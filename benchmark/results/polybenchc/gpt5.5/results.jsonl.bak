{\n      float *row_i = (float *)A[i];\n\n      for (j = 0; j < i; j++) {\n        float *row_j = (float *)A[j];\n        float aij = row_i[j];\n        size_t kk = 0;\n        size_t jj = (size_t)j;\n\n        while (kk < jj) {\n          size_t vl = __riscv_vsetvl_e32m4(jj - kk);\n          vfloat32m4_t vi = __riscv_vle32_v_f32m4(&row_i[kk], vl);\n          vfloat32m4_t vj = __riscv_vle32_v_f32m4(&row_j[kk], vl);\n          vfloat32m4_t vp = __riscv_vfmul_vv_f32m4(vi, vj, vl);\n          __riscv_vse32_v_f32m4(prod_buf, vp, vl);\n\n          for (size_t t = 0; t < vl; t++) {\n            aij -= prod_buf[t];\n          }\n          kk += vl;\n        }\n\n        row_i[j] = aij / row_j[j];\n      }\n\n      {\n        float aii = row_i[i];\n        size_t kk = 0;\n        size_t ii = (size_t)i;\n\n        while (kk < ii) {\n          size_t vl = __riscv_vsetvl_e32m4(ii - kk);\n          vfloat32m4_t vi = __riscv_vle32_v_f32m4(&row_i[kk], vl);\n          vfloat32m4_t vp = __riscv_vfmul_vv_f32m4(vi, vi, vl);\n          __riscv_vse32_v_f32m4(prod_buf, vp, vl);\n\n          for (size_t t = 0; t < vl; t++) {\n            aii -= prod_buf[t];\n          }\n          kk += vl;\n        }\n\n        row_i[i] = (float)SQRT_FUN(aii);\n      }\n    }\n    return;\n  }\n#endif\n\n  for (i = 0; i < _PB_N; i++) {\n    DATA_TYPE *row_i = A[i];\n\n    for (j = 0; j < i; j++) {\n      DATA_TYPE *row_j = A[j];\n      DATA_TYPE aij = row_i[j];\n\n      for (k = 0; k < j; k++) {\n        aij -= row_i[k] * row_j[k];\n      }\n      row_i[j] = aij / row_j[j];\n    }\n\n    {\n      DATA_TYPE aii = row_i[i];\n\n      for (k = 0; k < i; k++) {\n        aii -= row_i[k] * row_i[k];\n      }\n      row_i[i] = SQRT_FUN(aii);\n    }\n  }\n#pragma endscop\n\n}", "message": "", "debug": {"status": "pass", "stage": "performance", "error_type": "", "message": "", "global_sf_n": 1, "baseline_time_ms": 236413.478027, "optimized_time_ms": 202705.049072, "speedup_ratio": 1.166292991266, "baseline_times_