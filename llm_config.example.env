# LLM config (OpenAI-compatible chat endpoint)
api_base_url        = http://<host>:<port>/v1
api_key             = <key or EMPTY>
model               = <model name>
temperature         = 0
request_timeout_sec = 600
thinking            = disabled
# max_tokens        = 8192
# max_retries       = 2

# Embedding config (used by TextRAG / GraphRAG construction)
embedding_api_base_url = https://<embedding-host>/v1
embedding_api_key      = <embedding key>
embedding_model        = <embedding model name>
embedding_dimensions   = 1024
embedding_batch_size   = 10
