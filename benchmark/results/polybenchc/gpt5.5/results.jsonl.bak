{"id": "polybenchc_correlation", "status": "success", "rounds": 3, "best_round": 3, "best_speedup_ratio": 1.926987340478, "baseline_time_ms": 36926.124023, "optimized_time_ms": 19162.618896, "code": "#if defined(__riscv_vector)\n#include <riscv_vector.h>\n#endif\n\nstatic\nvoid kernel_correlation(int m, int n,\n\t\t\tDATA_TYPE float_n,\n\t\t\tDATA_TYPE POLYBENCH_2D(data,N,M,n,m),\n\t\t\tDATA_TYPE POLYBENCH_2D(corr,M,M,m,m),\n\t\t\tDATA_TYPE POLYBENCH_1D(mean,M,m),\n\t\t\tDATA_TYPE POLYBENCH_1D(stddev,M,m))\n{\n  int i, j, k;\n\n  DATA_TYPE eps = SCALAR_VAL(0.1);\n\n#pragma scop\n#if defined(__riscv_vector) && defined(DATA_TYPE_IS_DOUBLE)\n\n  {\n    const long corr_row_stride = (long)sizeof(corr[0]);\n    const double fn = (double)float_n;\n    const double sqrt_float_n = SQRT_FUN(float_n);\n\n    for (j = 0; j < _PB_M; )\n      {\n        size_t vl = __riscv_vsetvl_e64m1((size_t)(_PB_M - j));\n        vfloat64m1_t vacc = __riscv_vfmv_v_f_f64m1(0.0, vl);\n\n        for (i = 0; i < _PB_N; i++)\n          {\n            vfloat64m1_t v = __riscv_vle64_v_f64m1((const double *)&data[i][j], vl);\n            vacc = __riscv_vfadd_vv_f64m1(vacc, v, vl);\n          }\n\n        vacc = __riscv_vfdiv_vf_f64m1(vacc, fn, vl);\n        __riscv_vse64_v_f64m1((double *)&mean[j], vacc, vl);\n        j += (int)vl;\n      }\n\n    for (j = 0; j < _PB_M; )\n      {\n        size_t vl = __riscv_vsetvl_e64m1((size_t)(_PB_M - j));\n        vfloat64m1_t vacc = __riscv_vfmv_v_f_f64m1(0.0, vl);\n        vfloat64m1_t vmean = __riscv_vle64_v_f64m1((const double *)&mean[j], vl);\n\n        for (i = 0; i < _PB_N; i++)\n          {\n            vfloat64m1_t v = __riscv_vle64_v_f64m1((const double *)&data[i][j], vl);\n            vfloat64m1_t d = __riscv_vfsub_vv_f64m1(v, vmean, vl);\n            vfloat64m1_t p = __riscv_vfmul_vv_f64m1(d, d, vl);\n            vacc = __riscv_vfadd_vv_f64m1(vacc, p, vl);\n          }\n\n        vacc = __riscv_vfdiv_vf_f64m1(vacc, fn, vl);\n        vacc = __riscv_vfsqrt_v_f64m1(vacc, vl);\n        {\n          vbool64_t mask = __riscv_vmfle_vf_f64m1_b64(vacc, (double)eps, vl);\n          vacc = __riscv_vfmerge_vfm_f64m1(vacc, 1.0, mask, vl);\n        }\n        __riscv_vse64_v_f64m1((double *)&stddev[j], vacc, vl);\n        j += (int)vl;\n      }\n\n    for (i = 0; i < _PB_N; i++)\n      {\n        for (j = 0; j < _PB_M; )\n          {\n            size_t vl = __riscv_vsetvl_e64m1((size_t)(_PB_M - j));\n            vfloat64m1_t vd = __riscv_vle64_v_f64m1((const double *)&data[i][j], vl);\n            vfloat64m1_t vm = __riscv_vle64_v_f64m1((const double *)&mean[j], vl);\n            vfloat64m1_t vs = __riscv_vle64_v_f64m1((const double *)&stddev[j], vl);\n            vfloat64m1_t denom = __riscv_vfmul_vf_f64m1(vs, sqrt_float_n, vl);\n            vd = __riscv_vfsub_vv_f64m1(vd, vm, vl);\n            vd = __riscv_vfdiv_vv_f64m1(vd, denom, vl);\n            __riscv_vse64_v_f64m1((double *)&data[i][j], vd, vl);\n            j += (int)vl;\n          }\n      }\n\n    for (i = 0; i < _PB_M-1; i++)\n      {\n        corr[i][i] = SCALAR_VAL(1.0);\n\n        for (j = i + 1; j < _PB_M; )\n          {\n            size_t vl = __riscv_vsetvl_e64m1((size_t)(_PB_M - j));\n            vfloat64m1_t vacc = __riscv_vfmv_v_f_f64m1(0.0, vl);\n\n            for (k = 0; k < _PB_N; k++)\n              {\n                vfloat64m1_t vj = __riscv_vle64_v_f64m1((const double *)&data[k][j], vl);\n                vfloat64m1_t prod = __riscv_vfmul_vf_f64m1(vj, (double)data[k][i], vl);\n                vacc = __riscv_vfadd_vv_f64m1(vacc, prod, vl);\n              }\n\n            __riscv_vse64_v_f64m1((double *)&corr[i][j], vacc, vl);\n            __riscv_vsse64_v_f64m1((double *)&corr[j][i], corr_row_stride, vacc, vl);\n            j += (int)vl;\n          }\n      }\n    corr[_PB_M-1][_PB_M-1] = SCALAR_VAL(1.0);\n  }\n\n#elif defined(__riscv_vector) && defined(DATA_TYPE_IS_FLOAT)\n\n  {\n    const long corr_row_stride = (long)sizeof(corr[0]);\n    const float fn = (float)float_n;\n    const float sqrt_float_n = SQRT_FUN(float_n);\n\n    for (j = 0; j < _PB_M; )\n      {\n        size_t vl = __riscv_vsetvl_e32m1((size_t)(_PB_M - j));\n        vfloat32m1_t vacc = __riscv_vfmv_v_f_f32m1(0.0f, vl);\n\n        for (i = 0; i < _PB_N; i++)\n          {\n            vfloat32m1_t v = __riscv_vle32_v_f32m1((const float *)&data[i][j], vl);\n            vacc = __riscv_vfadd_vv_f32m1(vacc, v, vl);\n          }\n\n        vacc = __riscv_vfdiv_vf_f32m1(vacc, fn, vl);\n        __riscv_vse32_v_f32m1((float *)&mean[j], vacc, vl);\n        j += (int)vl;\n      }\n\n    for (j = 0; j < _PB_M; )\n      {\n        size_t vl = __riscv_vsetvl_e32m1((size_t)(_PB_M - j));\n        vfloat32m1_t vacc = __riscv_vfmv_v_f_f32m1(0.0f, vl);\n        vfloat32m1_t vmean = __riscv_vle32_v_f32m1((const float *)&mean[j], vl);\n\n        for (i = 0; i < _PB_N; i++)\n          {\n            vfloat32m1_t v = __riscv_vle32_v_f32m1((const float *)&data[i][j], vl);\n            vfloat32m1_t d = __riscv_vfsub_vv_f32m1(v, vmean, vl);\n            vfloat32m1_t p = __riscv_vfmul_vv_f32m1(d, d, vl);\n            vacc = __riscv_vfadd_vv_f32m1(vacc, p, vl);\n          }\n\n        vacc = __riscv_vfdiv_vf_f32m1(vacc, fn, vl);\n        vacc = __riscv_vfsqrt_v_f32m1(vacc, vl);\n        {\n          vbool32_t mask = __riscv_vmfle_vf_f32m1_b32(vacc, (float)eps, vl);\n          vacc = __riscv_vfmerge_vfm_f32m1(vacc, 1.0f, mask, vl);\n        }\n        __riscv_vse32_v_f32m1((float *)&stddev[j], vacc, vl);\n        j += (int)vl;\n      }\n\n    for (i = 0; i < _PB_N; i++)\n      {\n        for (j = 0; j < _PB_M; )\n          {\n            size_t vl = __riscv_vsetvl_e32m1((size_t)(_PB_M - j));\n            vfloat32m1_t vd = __riscv_vle32_v_f32m1((const float *)&data[i][j], vl);\n            vfloat32m1_t vm = __riscv_vle32_v_f32m1((const float *)&mean[j], vl);\n            vfloat32m1_t vs = __riscv_vle32_v_f32m1((const float *)&stddev[j], vl);\n            vfloat32m1_t denom = __riscv_vfmul_vf_f32m1(vs, sqrt_float_n, vl);\n            vd = __riscv_vfsub_vv_f32m1(vd, vm, vl);\n            vd = __riscv_vfdiv_vv_f32m1(vd, denom, vl);\n            __riscv_vse32_v_f32m1((float *)&data[i][j], vd, vl);\n            j += (int)vl;\n          }\n      }\n\n    for (i = 0; i < _PB_M-1; i++)\n      {\n        corr[i][i] = SCALAR_VAL(1.0);\n\n        for (j = i + 1; j < _PB_M; )\n          {\n            size_t vl = __riscv_vsetvl_e32m1((size_t)(_PB_M - j));\n            vfloat32m1_t vacc = __riscv_vfmv_v_f_f32m1(0.0f, vl);\n\n            for (k = 0; k < _PB_N; k++)\n              {\n                vfloat32m1_t vj = __riscv_vle32_v_f32m1((const float *)&data[k][j], vl);\n                vfloat32m1_t prod = __riscv_vfmul_vf_f32m1(vj, (float)data[k][i], vl);\n                vacc = __riscv_vfadd_vv_f32m1(vacc, prod, vl);\n              }\n\n            __riscv_vse32_v_f32m1((float *)&corr[i][j], vacc, vl);\n            __riscv_vsse32_v_f32m1((float *)&corr[j][i], corr_row_stride, vacc, vl);\n            j += (int)vl;\n          }\n      }\n    corr[_PB_M-1][_PB_M-1] = SCALAR_VAL(1.0);\n  }\n\n#else\n\n  for (j = 0; j < _PB_M; j++)\n    {\n      mean[j] = SCALAR_VAL(0.0);\n      for (i = 0; i < _PB_N; i++)\n\tmean[j] += data[i][j];\n      mean[j] /= float_n;\n    }\n\n   for (j = 0; j < _PB_M; j++)\n    {\n      stddev[j] = SCALAR_VAL(0.0);\n      for (i = 0; i < _PB_N; i++)\n        stddev[j] += (data[i][j] - mean[j]) * (data[i][j] - mean[j]);\n      stddev[j] /= float_n;\n      stddev[j] = SQRT_FUN(stddev[j]);\n      \n\n      stddev[j] = stddev[j] <= eps ? SCALAR_VAL(1.0) : stddev[j];\n    }\n\n  \n  for (i = 0; i < _PB_N; i++)\n    for (j = 0; j < _PB_M; j++)\n      {\n        data[i][j] -= mean[j];\n        data[i][j] /= SQRT_FUN(float_n) * stddev[j];\n      }\n\n  \n  for (i = 0; i < _PB_M-1; i++)\n    {\n      corr[i][i] = SCALAR_VAL(1.0);\n      for (j = i+1; j < _PB_M; j++)\n        {\n          corr[i][j] = SCALAR_VAL(0.0);\n          fo