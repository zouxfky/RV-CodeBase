riscv_vse64_v_f64m4(x2d + ii, vx, vl);\n        ii += (int)vl;\n      }\n    }\n  } else if (sizeof(DATA_TYPE) == sizeof(float) && (DATA_TYPE)0.5 != (DATA_TYPE)0) {\n    float *x1f = (float *)x1;\n    float *x2f = (float *)x2;\n    float *y1f = (float *)y_1;\n    float *y2f = (float *)y_2;\n\n    for (i = 0; i < _PB_N; i++) {\n      float acc = x1f[i];\n      float *arow = (float *)&A[i][0];\n      int jj = 0;\n\n      if (_PB_N > 0) {\n        size_t vl = __riscv_vsetvl_e32m8((size_t)_PB_N);\n        vfloat32m8_t vacc = __riscv_vfmv_v_f_f32m8(0.0f, vl);\n\n        for (; jj + (int)vl <= _PB_N; jj += (int)vl) {\n          vfloat32m8_t va = __riscv_vle32_v_f32m8(arow + jj, vl);\n          vfloat32m8_t vy = __riscv_vle32_v_f32m8(y1f + jj, vl);\n          vacc = __riscv_vfmacc_vv_f32m8(vacc, va, vy, vl);\n        }\n\n        vfloat32m1_t vzero = __riscv_vfmv_s_f_f32m1(0.0f, 1);\n        vfloat32m1_t vred = __riscv_vfredusum_vs_f32m8_f32m1(vacc, vzero, vl);\n        acc += __riscv_vfmv_f_s_f32m1_f32(vred);\n      }\n\n      for (; jj < _PB_N; jj++)\n        acc += arow[jj] * y1f[jj];\n\n      x1f[i] = acc;\n    }\n\n    for (j = 0; j < _PB_N; j++) {\n      float y = y2f[j];\n      float *arow = (float *)&A[j][0];\n      int ii = 0;\n\n      while (ii < _PB_N) {\n        size_t vl = __riscv_vsetvl_e32m8((size_t)(_PB_N - ii));\n        vfloat32m8_t vx = __riscv_vle32_v_f32m8(x2f + ii, vl);\n        vfloat32m8_t va = __riscv_vle32_v_f32m8(arow + ii, vl);\n        vx = __riscv_vfmacc_vf_f32m8(vx, y, va, vl);\n        __riscv_vse32_v_f32m8(x2f + ii, vx, vl);\n        ii += (int)vl;\n      }\n    }\n  } else\n#endif\n  {\n    for (i = 0; i < _PB_N; i++)\n      for (j = 0; j < _PB_N; j++)\n        x1[i] = x1[i] + A[i][j] * y_1[j];\n\n    for (i = 0; i < _PB_N; i++)\n      for (j = 0; j < _PB_N; j++)\n        x2[i] = x2[i] + A[j][i] * y_2[j];\n  }\n#pragma endscop\n\n}", "message": "", "debug": {"status": "pass", "stage": "performance", "error_type": "", "message": "", "global