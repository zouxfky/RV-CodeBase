{"id": "polybenchc_lu", "status": "success", "rounds": 3, "best_round": 2, "best_speedup_ratio": 1.048380984304, "baseline_time_ms": 234784.454834, "optimized_time_ms": 223949.554932, "code": "#if defined(__riscv_vector)\n#include <riscv_vector.h>\n#endif\n\nstatic\nvoid kernel_lu(int n,\n\t       DATA_TYPE POLYBENCH_2D(A,N,N,n,n))\n{\n  int i, j, k;\n\n#pragma scop\n  for (i = 0; i < _PB_N; i++) {\n    for (j = 0; j < i; j++) {\n      for (k = 0; k < j; k++) {\n        A[i][j] -= A[i][k] * A[k][j];\n      }\n      A[i][j] /= A[j][j];\n    }\n\n#if defined(__riscv_vector)\n    if (__builtin_types_compatible_p(__typeof__(A[0][0]), double)) {\n      for (j = i; j < _PB_N; ) {\n        size_t vl = __riscv_vsetvl_e64m4((size_t)(_PB_N - j));\n\n        double *ai = (double *)&A[i][j];\n        vfloat64m4_t vai = __riscv_vle64_v_f64m4(ai, vl);\n\n        for (k = 0; k < i; k++) {\n          const double aik = (double)A[i][k];\n          const double *ak = (const double *)&A[k][j];\n          vfloat64m4_t vak = __riscv_vle64_v_f64m4(ak, vl);\n          vfloat64m4_t vprod = __riscv_vfmul_vf_f64m4(vak, aik, vl);\n          vai = __riscv_vfsub_vv_f64m4(vai, vprod, vl);\n        }\n\n        __riscv_vse64_v_f64m4(ai, vai, vl);\n        j += (int)vl;\n      }\n    } else if (__builtin_types_compatible_p(__typeof__(A[0][0]), float)) {\n      for (j = i; j < _PB_N; ) {\n        size_t vl = __riscv_vsetvl_e32m4((size_t)(_PB_N - j));\n\n        float *ai = (float *)&A[i][j];\n        vfloat32m4_t vai = __riscv_vle32_v_f32m4(ai, vl);\n\n        for (k = 0; k < i; k++) {\n          const float aik = (float)A[i][k];\n          const float *ak = (const float *)&A[k][j];\n          vfloat32m4_t vak = __riscv_vle32_v_f32m4(ak, vl);\n          vfloat32m4_t vprod = __riscv_vfmul_vf_f32m4(vak, aik, vl);\n          vai = __riscv_vfsub_vv_f32m4(vai, vprod, vl);\n        }\n\n        __riscv_vse32_v_f32m4(ai, vai, vl);\n        j += (int)vl;\n      }\n    } else\n#endif\n    {\n      for (j = 