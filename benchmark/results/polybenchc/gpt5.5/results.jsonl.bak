{"id": "polybenchc_jacobi_1d", "status": "success", "rounds": 3, "best_round": 3, "best_speedup_ratio": 1.151445686565, "baseline_time_ms": 35.925049, "optimized_time_ms": 31.199951, "code": "#if defined(__riscv_vector)\n#include <riscv_vector.h>\n#endif\n\nstatic\nvoid kernel_jacobi_1d(int tsteps,\n\t\t\t    int n,\n\t\t\t    DATA_TYPE POLYBENCH_1D(A,N,n),\n\t\t\t    DATA_TYPE POLYBENCH_1D(B,N,n))\n{\n  int t, i;\n\n  {\n    unsigned long a_addr = (unsigned long)(const void *)A;\n    unsigned long b_addr = (unsigned long)(const void *)B;\n    unsigned long bytes = (unsigned long)_PB_N * (unsigned long)sizeof(DATA_TYPE);\n    int no_overlap = (a_addr <= b_addr) ? (bytes <= b_addr - a_addr)\n                                        : (bytes <= a_addr - b_addr);\n\n    if (no_overlap)\n      {\n\tDATA_TYPE *__restrict__ Ar = A;\n\tDATA_TYPE *__restrict__ Br = B;\n\n#pragma scop\n\tfor (t = 0; t < _PB_TSTEPS; t++)\n\t  {\n#pragma GCC ivdep\n\t    for (i = 1; i < _PB_N - 1; i++)\n\t      Br[i] = 0.33333 * (Ar[i-1] + Ar[i] + Ar[i + 1]);\n\n#pragma GCC ivdep\n\t    for (i = 1; i < _PB_N - 1; i++)\n\t      Ar[i] = 0.33333 * (Br[i-1] + Br[i] + Br[i + 1]);\n\t  }\n#pragma endscop\n\treturn;\n      }\n  }\n\n#pragma scop\n  for (t = 0; t < _PB_TSTEPS; t++)\n    {\n      for (i = 1; i < _PB_N - 1; i++)\n\tB[i] = 0.33333 * (A[i-1] + A[i] + A[i + 1]);\n      for (i = 1; i < _PB_N - 1; i++)\n\tA[i] = 0.33333 * (B[i-1] + B[i] + B[i + 1]);\n    }\n#pragma endscop\n\n}", "message": "", "debug": {"status": "pass", "stage": "performance", "error_type": "", "message": "", "global_sf_n": 1, "baseline_time_ms": 35.925049, "optimized_time_ms": 31.199951, "speedup_ratio": 1.151445686565, "baseline_times_ms": [35.925049], "optimized_times_ms": [31.199951], "cases": [{"testcase_index": 0, "baseline_returncode": 0, "optimized_returncode": 0, "baseline_time_ms": 35.925049, "optimized_time_ms": 31.199951, "output_match": true, "message": ""}]}, "rounds_history": [{"round": 1, "status": "pass", "