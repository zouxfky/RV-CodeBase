{"id": "polybenchc_durbin", "status": "success", "rounds": 3, "best_round": 2, "best_speedup_ratio": 1.130676574448, "baseline_time_ms": 50.579834, "optimized_time_ms": 44.734131, "code": "#if defined(__riscv_vector)\n#include <riscv_vector.h>\n#endif\n\nstatic\nvoid kernel_durbin(int n,\n\t\t   DATA_TYPE POLYBENCH_1D(r,N,n),\n\t\t   DATA_TYPE POLYBENCH_1D(y,N,n))\n{\n DATA_TYPE z[N];\n DATA_TYPE alpha;\n DATA_TYPE beta;\n DATA_TYPE sum;\n\n int i,k;\n\n#pragma scop\n y[0] = -r[0];\n beta = SCALAR_VAL(1.0);\n alpha = -r[0];\n\n for (k = 1; k < _PB_N; k++) {\n   beta = (SCALAR_VAL(1.0)-alpha*alpha)*beta;\n\n#if defined(__riscv_vector) && defined(DATA_TYPE_IS_FLOAT)\n   sum = SCALAR_VAL(0.0);\n   for (i=0; i<k; ) {\n     unsigned long vl = __riscv_vsetvl_e32m8((unsigned long)(k - i));\n     vfloat32m8_t vr = __riscv_vlse32_v_f32m8(&r[k-i-1], -((long)sizeof(DATA_TYPE)), vl);\n     vfloat32m8_t vy = __riscv_vle32_v_f32m8(&y[i], vl);\n     vfloat32m8_t vp = __riscv_vfmul_vv_f32m8(vr, vy, vl);\n     vfloat32m1_t vzero = __riscv_vfmv_s_f_f32m1(SCALAR_VAL(0.0), vl);\n     vfloat32m1_t vred = __riscv_vfredusum_vs_f32m8_f32m1(vp, vzero, vl);\n     sum += __riscv_vfmv_f_s_f32m1_f32(vred);\n     i += (int)vl;\n   }\n\n   alpha = - (r[k] + sum)/beta;\n\n   for (i=0; i<k; ) {\n     unsigned long vl = __riscv_vsetvl_e32m8((unsigned long)(k - i));\n     vfloat32m8_t vy  = __riscv_vle32_v_f32m8(&y[i], vl);\n     vfloat32m8_t vyr = __riscv_vlse32_v_f32m8(&y[k-i-1], -((long)sizeof(DATA_TYPE)), vl);\n     vfloat32m8_t vz  = __riscv_vfmacc_vf_f32m8(vy, alpha, vyr, vl);\n     __riscv_vse32_v_f32m8(&z[i], vz, vl);\n     i += (int)vl;\n   }\n\n   for (i=0; i<k; ) {\n     unsigned long vl = __riscv_vsetvl_e32m8((unsigned long)(k - i));\n     vfloat32m8_t vz = __riscv_vle32_v_f32m8(&z[i], vl);\n     __riscv_vse32_v_f32m8(&y[i], vz, vl);\n     i += (int)vl;\n   }\n#elif defined(__riscv_vector)\n   sum = SCALAR_VAL(0.0);\n   for (i=0; i<k; ) {\n     unsigned long vl = __riscv_vsetvl_e64m8((unsigned long)(k - i));\n     vfloat64m8_t vr = __riscv_vlse64_v_f64m8(&r[k-i-1], -((long)sizeof(DATA_TYPE)), vl);\n     vfloat64m8_t vy = __riscv_vle64_v_f64m8(&y[i], vl);\n     vfloat64m8_t vp = __riscv_vfmul_vv_f64m8(vr, vy, vl);\n     vfloat64m1_t vzero = __riscv_vfmv_s_f_f64m1(SCALAR_VAL(0.0), vl);\n     vfloat64m1_t vred = __riscv_vfredusum_vs_f64m8_f64m1(vp, vzero, vl);\n     sum += __riscv_vfmv_f_s_f64m1_f64(vred);\n     i += (int)vl;\n   }\n\n   alpha = - (r[k] + sum)/beta;\n\n   for (i=0; i<k; ) {\n     unsigned long vl = __riscv_vsetvl_e64m8((unsigned long)(k - i));\n     vfloat64m8_t vy  = __riscv_vle64_v_f64m8(&y[i], vl);\n     vfloat64m8_t vyr = __riscv_vlse64_v_f64m8(&y[k-i-1], -((long)sizeof(DATA_TYPE)), vl);\n     vfloat64m8_t vz  = __riscv_vfmacc_vf_f64m8(vy, alpha, vyr, vl);\n     __riscv_vse64_v_f64m8(&z[i], vz, vl);\n     i += (int)vl;\n   }\n\n   for (i=0; i<k; ) {\n     unsigned long vl = __riscv_vsetvl_e64m8((unsigned long)(k - i));\n     vfloat64m8_t vz = __riscv_vle64_v_f64m8(&z[i], vl);\n     __riscv_vse64_v_f64m8(&y[i], vz, vl);\n     i += (int)vl;\n   }\n#else\n   sum = SCALAR_VAL(0.0);\n   {\n     DATA_TYPE const *rp = &r[k-1];\n     DATA_TYPE const *yp = y;\n     for (i=0; i<k; i++) {\n        sum += (*rp--)*(*yp++);\n     }\n   }\n\n   alpha = - (r[k] + sum)/beta;\n\n   for (i=0; i<k; i++) {\n      z[i] = y[i] + alpha*y[k-i-1];\n   }\n   for (i=0; i<k; i++) {\n     y[i] = z[i];\n   }\n#endif\n\n   y[k] = alpha;\n }\n#pragma endscop\n\n}", "message": "", "debug": {"status": "pass", "stage": "performance", "error_type": "", "message": "", "global_sf_n": 1, "baseline_time_ms": 50.579834, "optimized_time_ms": 44.734131, "speedup_ratio": 1.130676574448, "baseline_times_ms": [50.579834], "optimized_times_ms": [44.734131], "cases": [{"testcase_index": 0, "baseline_returncode": 0, "optimized_returncode": 0, "baseline_time_ms": 50.579834, "optimized_time_ms": 44.734131, "output_match": true, "message": ""}]}, "rounds_history": [{"round": 1, "stat