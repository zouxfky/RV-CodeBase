{"id": "polybenchc_adi", "status": "success", "rounds": 3, "best_round": 3, "best_speedup_ratio": 1.042346695884, "baseline_time_ms": 41911.386963, "optimized_time_ms": 40208.682129, "code": "static\nvoid kernel_adi(int tsteps, int n,\n\t\tDATA_TYPE POLYBENCH_2D(u,N,N,n,n),\n\t\tDATA_TYPE POLYBENCH_2D(v,N,N,n,n),\n\t\tDATA_TYPE POLYBENCH_2D(p,N,N,n,n),\n\t\tDATA_TYPE POLYBENCH_2D(q,N,N,n,n))\n{\n  int t, i, j;\n  DATA_TYPE DX, DY, DT;\n  DATA_TYPE B1, B2;\n  DATA_TYPE mul1, mul2;\n  DATA_TYPE a, b, c, d, e, f;\n\n#pragma scop\n\n  DX = SCALAR_VAL(1.0)/(DATA_TYPE)_PB_N;\n  DY = SCALAR_VAL(1.0)/(DATA_TYPE)_PB_N;\n  DT = SCALAR_VAL(1.0)/(DATA_TYPE)_PB_TSTEPS;\n  B1 = SCALAR_VAL(2.0);\n  B2 = SCALAR_VAL(1.0);\n  mul1 = B1 * DT / (DX * DX);\n  mul2 = B2 * DT / (DY * DY);\n\n  a = -mul1 /  SCALAR_VAL(2.0);\n  b = SCALAR_VAL(1.0)+mul1;\n  c = a;\n  d = -mul2 / SCALAR_VAL(2.0);\n  e = SCALAR_VAL(1.0)+mul2;\n  f = d;\n\n  {\n    const int n_end = _PB_N - 1;\n    const int stride = n;\n    const DATA_TYPE one = SCALAR_VAL(1.0);\n    const DATA_TYPE zero = SCALAR_VAL(0.0);\n    const DATA_TYPE neg_a = -a;\n    const DATA_TYPE neg_c = -c;\n    const DATA_TYPE neg_d = -d;\n    const DATA_TYPE neg_f = -f;\n    const DATA_TYPE mid_d = SCALAR_VAL(1.0) + SCALAR_VAL(2.0) * d;\n    const DATA_TYPE mid_a = SCALAR_VAL(1.0) + SCALAR_VAL(2.0) * a;\n\n    for (t = 1; t <= _PB_TSTEPS; t++) {\n\n      for (i = 1; i < n_end; i++) {\n        DATA_TYPE *p_i = p[i];\n        DATA_TYPE *q_i = q[i];\n\n        DATA_TYPE pprev = zero;\n        DATA_TYPE qprev = one;\n\n        v[0][i] = one;\n        p_i[0] = zero;\n        q_i[0] = one;\n\n        {\n          DATA_TYPE *um = &u[1][i-1];\n          DATA_TYPE *uc = &u[1][i];\n          DATA_TYPE *up = &u[1][i+1];\n\n          for (j = 1; j < n_end; j++) {\n            DATA_TYPE denom = a * pprev + b;\n            DATA_TYPE pcur = neg_c / denom;\n            DATA_TYPE qcur = (neg_d * (*um) + mid_d * (*uc) + neg_f * (*up) + neg_a * qprev) / denom;\n\n            p_i[j] = pcur;\n            q_i[j] = qcur;\n\n            pprev = pcur;\n            qprev = qcur;\n\n            um += stride;\n            uc += stride;\n            up += stride;\n          }\n        }\n\n        v[n_end][i] = one;\n        {\n          DATA_TYPE vnext = one;\n          DATA_TYPE *vcurp = &v[n_end-1][i];\n          for (j = n_end - 1; j >= 1; j--) {\n            DATA_TYPE vcur = p_i[j] * vnext + q_i[j];\n            *vcurp = vcur;\n            vnext = vcur;\n            vcurp -= stride;\n          }\n        }\n      }\n\n      for (i = 1; i < n_end; i++) {\n        DATA_TYPE *u_i = u[i];\n        DATA_TYPE *p_i = p[i];\n        DATA_TYPE *q_i = q[i];\n\n        DATA_TYPE pprev = zero;\n        DATA_TYPE qprev = one;\n\n        u_i[0] = one;\n        p_i[0] = zero;\n        q_i[0] = one;\n\n        {\n          DATA_TYPE *vm = &v[i-1][1];\n          DATA_TYPE *vc = &v[i][1];\n          DATA_TYPE *vp = &v[i+1][1];\n\n          for (j = 1; j < n_end; j++) {\n            DATA_TYPE denom = d * pprev + e;\n            DATA_TYPE pcur = neg_f / denom;\n            DATA_TYPE qcur = (neg_a * vm[j-1] + mid_a * vc[j-1] + neg_c * vp[j-1] + neg_d * qprev) / denom;\n\n            p_i[j] = pcur;\n            q_i[j] = qcur;\n\n            pprev = pcur;\n            qprev = qcur;\n          }\n        }\n\n        u_i[n_end] = one;\n        {\n          DATA_TYPE unext = one;\n          for (j = n_end - 1; j >= 1; j--) {\n            DATA_TYPE ucur = p_i[j] * unext + q_i[j];\n            u_i[j] = ucur;\n            unext = ucur;\n          }\n        }\n      }\n    }\n  }\n#pragma endscop\n}", "message": "", "debug": {"status": "pass", "stage": "performance", "error_type": "", "message": "", "global_sf_n": 1, "baseline_time_ms": 41911.386963, "optimized_time_ms": 40208.682129, "speedup_ratio": 1.042346695884, "baseline_times_ms": [41911.386963], "optimized_times_ms": [40208.682129], "cases": [{"testcase_index": 0, "baseline_returncode": 0, "optimiz