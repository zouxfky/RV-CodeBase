{"id": "polybenchc_fdtd_2d", "status": "success", "rounds": 3, "best_round": 3, "best_speedup_ratio": 1.679896930765, "baseline_time_ms": 14168.438965, "optimized_time_ms": 8434.112061, "code": "static\nvoid kernel_fdtd_2d(int tmax,\n\t\t    int nx,\n\t\t    int ny,\n\t\t    DATA_TYPE POLYBENCH_2D(ex,NX,NY,nx,ny),\n\t\t    DATA_TYPE POLYBENCH_2D(ey,NX,NY,nx,ny),\n\t\t    DATA_TYPE POLYBENCH_2D(hz,NX,NY,nx,ny),\n\t\t    DATA_TYPE POLYBENCH_1D(_fict_,TMAX,tmax))\n{\n  int t, i, j;\n\n#pragma scop\n\n  const int NXv = _PB_NX;\n  const int NYv = _PB_NY;\n  const int TMAXv = _PB_TMAX;\n  const DATA_TYPE c05 = SCALAR_VAL(0.5);\n  const DATA_TYPE c07 = SCALAR_VAL(0.7);\n\n  for (t = 0; t < TMAXv; t++)\n    {\n      DATA_TYPE ft = _fict_[t];\n\n      DATA_TYPE *ey0 = &ey[0][0];\n#pragma GCC ivdep\n      for (j = 0; j < NYv; j++)\n\tey0[j] = ft;\n\n      for (i = 1; i < NXv; i++)\n\t{\n\t  DATA_TYPE *eyi = &ey[i][0];\n\t  DATA_TYPE *hzi = &hz[i][0];\n\t  DATA_TYPE *hzip = &hz[i - 1][0];\n#pragma GCC ivdep\n\t  for (j = 0; j < NYv; j++)\n\t    eyi[j] = eyi[j] - c05 * (hzi[j] - hzip[j]);\n\t}\n\n      for (i = 0; i < NXv; i++)\n\t{\n\t  DATA_TYPE *exi = &ex[i][0];\n\t  DATA_TYPE *hzi = &hz[i][0];\n#pragma GCC ivdep\n\t  for (j = 1; j < NYv; j++)\n\t    exi[j] = exi[j] - c05 * (hzi[j] - hzi[j - 1]);\n\t}\n\n      for (i = 0; i < NXv - 1; i++)\n\t{\n\t  DATA_TYPE *hzi = &hz[i][0];\n\t  DATA_TYPE *exi = &ex[i][0];\n\t  DATA_TYPE *eyi = &ey[i][0];\n\t  DATA_TYPE *eyin = &ey[i + 1][0];\n#pragma GCC ivdep\n\t  for (j = 0; j < NYv - 1; j++)\n\t    hzi[j] = hzi[j] - c07 * (exi[j + 1] - exi[j] + eyin[j] - eyi[j]);\n\t}\n    }\n\n#pragma endscop\n}", "message": "", "debug": {"status": "pass", "stage": "performance", "error_type": "", "message": "", "global_sf_n": 1, "baseline_time_ms": 14168.438965, "optimized_time_ms": 8434.112061, "speedup_ratio": 1.679896930765, "baseline_times_ms": [14168.438965], "optimized_times_ms": [8434.112061], "cases": [{"testcase_index": 0, "baseline_returnc