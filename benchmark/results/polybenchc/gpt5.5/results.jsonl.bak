{"id": "polybenchc_nussinov", "status": "success", "rounds": 3, "best_round": 3, "best_speedup_ratio": 1.405367905813, "baseline_time_ms": 50119.72998, "optimized_time_ms": 35663.067139, "code": "#if defined(__riscv_vector)\n#include <riscv_vector.h>\n#endif\n\nstatic\nvoid kernel_nussinov(int n, base POLYBENCH_1D(seq,N,n),\n\t\t\t   DATA_TYPE POLYBENCH_2D(table,N,N,n,n))\n{\n  int i, j, k;\n\n#pragma scop\n  for (i = _PB_N - 1; i >= 0; i--) {\n    if (i + 1 >= _PB_N)\n      continue;\n\n    DATA_TYPE *row_i = table[i];\n    DATA_TYPE *row_ip1 = table[i + 1];\n\n    for (j = i + 1; j < _PB_N; j++) {\n      DATA_TYPE cur;\n\n      cur = row_i[j];\n      cur = max_score(cur, row_i[j - 1]);\n      cur = max_score(cur, row_ip1[j]);\n\n      if (i < j - 1)\n        cur = max_score(cur, row_ip1[j - 1] + match(seq[i], seq[j]));\n      else\n        cur = max_score(cur, row_ip1[j - 1]);\n\n      row_i[j] = cur;\n\n#if defined(__riscv_vector)\n      if (sizeof(DATA_TYPE) == sizeof(int)) {\n        int best = (int)cur;\n        const long stride_bytes = (long)sizeof(table[0]);\n        const size_t vlmax = __riscv_vsetvl_e32m8((size_t)-1);\n\n        k = i + 1;\n\n        if ((size_t)(j - k) >= vlmax) {\n          vint32m8_t v_best = __riscv_vmv_v_x_i32m8(best, vlmax);\n\n          do {\n            vint32m8_t v_left =\n              __riscv_vle32_v_i32m8((const int *)&row_i[k], vlmax);\n            vint32m8_t v_down =\n              __riscv_vlse32_v_i32m8((const int *)&table[k + 1][j],\n                                     stride_bytes, vlmax);\n            vint32m8_t v_sum =\n              __riscv_vadd_vv_i32m8(v_left, v_down, vlmax);\n\n            v_best = __riscv_vmax_vv_i32m8(v_best, v_sum, vlmax);\n            k += (int)vlmax;\n          } while ((size_t)(j - k) >= vlmax);\n\n          {\n            vint32m1_t v_init = __riscv_vmv_v_x_i32m1(best, 1);\n            vint32m1_t v_red =\n              __riscv_vredmax_vs_i32m8_i32m1(v_best, v_init, vlmax);\n            __riscv_vse32_v_i32m1(&best, v_red, 1);\n          }\n        }\n\n        if (k < j) {\n          size_t vl = __riscv_vsetvl_e32m8((size_t)(j - k));\n\n          vint32m8_t v_left =\n            __riscv_vle32_v_i32m8((const int *)&row_i[k], vl);\n          vint32m8_t v_down =\n            __riscv_vlse32_v_i32m8((const int *)&table[k + 1][j],\n                                   stride_bytes, vl);\n          vint32m8_t v_sum =\n            __riscv_vadd_vv_i32m8(v_left, v_down, vl);\n\n          vint32m1_t v_init = __riscv_vmv_v_x_i32m1(best, 1);\n          vint32m1_t v_red =\n            __riscv_vredmax_vs_i32m8_i32m1(v_sum, v_init, vl);\n          __riscv_vse32_v_i32m1(&best, v_red, 1);\n        }\n\n        row_i[j] = (DATA_TYPE)best;\n      } else\n#endif\n      {\n        for (k = i + 1; k < j; k++) {\n          row_i[j] = max_score(row_i[j], row_i[k] + table[k + 1][j]);\n        }\n      }\n    }\n  }\n#pragma endscop\n\n}", "message": "", "debug": {"status": "pass", "stage": "performance", "error_type": "", "message": "", "global_sf_n": 1, "baseline_time_ms": 50119.72998, "optimized_time_ms": 35663.067139, "speedup_ratio": 1.405367905813, "baseline_times_ms": [50119.72998], "optimized_times_ms": [35663.067139], "cases": [{"testcase_index": 0, "baseline_returncode": 0, "optimized_returncode": 0, "baseline_time_ms": 50119.72998, "optimized_time_ms": 35663.067139, "output_match": true, "message": ""}]}, "rounds_history": [{"round": 1, "status": "fail", "stage": "compile", "error_type": "optimized_compile", "speedup": 0.0, "baseline": 0.0, "optimized": 0.0, "message": "optimized.cpp: 在函数‘kernel_nussinov’中:\noptimized.cpp:107:18: 错误：implicit declaration of function ‘__riscv_vmv_x_s_i32m1’; did you mean ‘__riscv_vmv_s_x_i32m1’? [-Wimplicit-function-declaration]\n  107 |           best = __riscv_vmv_x_s_i32m1(v_red);\n      |                  ^~~~~~~~~~~~~~~~~~~~~\n      |                  __riscv_vmv_s_x_i32m1"}, {"round": 2, "status": "pass", "stage": "performance", "er