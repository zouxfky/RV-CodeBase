{"id": "polybenchc_ludcmp", "status": "success", "rounds": 3, "best_round": 3, "best_speedup_ratio": 1.122898076192, "baseline_time_ms": 234497.844971, "optimized_time_ms": 208832.707031, "code": "#if defined(__riscv_vector)\n#include <riscv_vector.h>\n#endif\n\nstatic\nvoid kernel_ludcmp(int n,\n\t\t   DATA_TYPE POLYBENCH_2D(A,N,N,n,n),\n\t\t   DATA_TYPE POLYBENCH_1D(b,N,n),\n\t\t   DATA_TYPE POLYBENCH_1D(x,N,n),\n\t\t   DATA_TYPE POLYBENCH_1D(y,N,n))\n{\n  int i, j, k;\n  DATA_TYPE w;\n\n#pragma scop\n  for (i = 0; i < _PB_N; i++) {\n    DATA_TYPE *Ai = &A[i][0];\n\n    for (k = 0; k < i; k++) {\n      Ai[k] = Ai[k] / A[k][k];\n      const DATA_TYPE aik = Ai[k];\n\n      j = k + 1;\n#if defined(__riscv_vector)\n      while (j < _PB_N) {\n        unsigned long vl = __riscv_vsetvl_e64m1((unsigned long)(_PB_N - j));\n        vfloat64m1_t vai = __riscv_vle64_v_f64m1((const double *)(Ai + j), vl);\n        vfloat64m1_t vak = __riscv_vle64_v_f64m1((const double *)(&A[k][j]), vl);\n        vfloat64m1_t vprod = __riscv_vfmul_vf_f64m1(vak, (double)aik, vl);\n        vai = __riscv_vfsub_vv_f64m1(vai, vprod, vl);\n        __riscv_vse64_v_f64m1((double *)(Ai + j), vai, vl);\n        j += (int)vl;\n      }\n#else\n      for (; j < _PB_N; j++) {\n        Ai[j] -= aik * A[k][j];\n      }\n#endif\n    }\n  }\n\n  for (i = 0; i < _PB_N; i++) {\n    DATA_TYPE *Ai = &A[i][0];\n    w = b[i];\n    for (j = 0; j < i; j++)\n      w -= Ai[j] * y[j];\n    y[i] = w;\n  }\n\n  for (i = _PB_N - 1; i >= 0; i--) {\n    DATA_TYPE *Ai = &A[i][0];\n    w = y[i];\n    for (j = i + 1; j < _PB_N; j++)\n      w -= Ai[j] * x[j];\n    x[i] = w / Ai[i];\n  }\n#pragma endscop\n}", "message": "", "debug": {"status": "pass", "stage": "performance", "error_type": "", "message": "", "global_sf_n": 1, "baseline_time_ms": 234497.844971, "optimized_time_ms": 208832.707031, "speedup_ratio": 1.122898076192, "baseline_times_ms": [234497.844971], "optimized_times_ms": [208832.707031], "cases": [{"testcase_index": 0