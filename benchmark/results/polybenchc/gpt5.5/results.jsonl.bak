{"id": "polybenchc_seidel_2d", "status": "success", "rounds": 3, "best_round": 2, "best_speedup_ratio": 1.000001171669, "baseline_time_ms": 40215.312988, "optimized_time_ms": 40215.265869, "code": "static\nvoid kernel_seidel_2d(int tsteps,\n\t\t      int n,\n\t\t      DATA_TYPE POLYBENCH_2D(A,N,N,n,n))\n{\n  int t, i, j;\n\n#pragma scop\n  for (t = 0; t < _PB_TSTEPS; t++) {\n    for (i = 1; i < _PB_N - 1; i++) {\n      DATA_TYPE *rowm = A[i - 1];\n      DATA_TYPE *row  = A[i];\n      DATA_TYPE *rowp = A[i + 1];\n\n      DATA_TYPE up_l = rowm[0];\n      DATA_TYPE up_c = rowm[1];\n      DATA_TYPE lo_l = rowp[0];\n      DATA_TYPE lo_c = rowp[1];\n\n      DATA_TYPE left = row[0];\n      DATA_TYPE center = row[1];\n\n      for (j = 1; j < _PB_N - 1; j++) {\n\tDATA_TYPE up_r = rowm[j + 1];\n\tDATA_TYPE right = row[j + 1];\n\tDATA_TYPE lo_r = rowp[j + 1];\n\n\tDATA_TYPE sum = up_l + up_c;\n\tsum = sum + up_r;\n\tsum = sum + left;\n\tsum = sum + center;\n\tsum = sum + right;\n\tsum = sum + lo_l;\n\tsum = sum + lo_c;\n\tsum = sum + lo_r;\n\n\tDATA_TYPE val = sum / SCALAR_VAL(9.0);\n\trow[j] = val;\n\n\tup_l = up_c;\n\tup_c = up_r;\n\tlo_l = lo_c;\n\tlo_c = lo_r;\n\tleft = val;\n\tcenter = right;\n      }\n    }\n  }\n#pragma endscop\n\n}", "message": "", "debug": {"status": "pass", "stage": "performance", "error_type": "", "message": "", "global_sf_n": 1, "baseline_time_ms": 40215.312988, "optimized_time_ms": 40215.265869, "speedup_ratio": 1.000001171669, "baseline_times_ms": [40215.312988], "optimized_times_ms": [40215.265869], "cases": [{"testcase_index": 0, "baseline_returncode": 0, "optimized_returncode": 0, "baseline_time_ms": 40215.312988, "optimized_time_ms": 40215.265869, "output_match": true, "message": ""}]}, "rounds_history": [{"round": 1, "status": "pass", "stage": "performance", "error_type": "", "speedup": 0.918807530574, "baseline": 40215.181152, "optimized": 43768.88501, "message": ""}, {"round": 2, "status": "pass", "stage": "performance", "error_type": "", 